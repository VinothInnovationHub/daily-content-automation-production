APP_ENV=local
DATABASE_URL=sqlite+aiosqlite:///./data/content.db

# Change these in Render. Never commit real secrets.
ADMIN_TOKEN=change-this-long-random-token
CRON_SECRET=change-this-long-random-cron-secret

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=

ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-5

TIMEZONE=Asia/Kolkata
DAILY_RUN_HOUR=11
DAILY_RUN_MINUTE=0

# Safety defaults
PUBLISH_ENABLED=false
LINKEDIN_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202606

# Medium auto-publishing is intentionally not supported by this project.
MEDIUM_ENABLED=false
